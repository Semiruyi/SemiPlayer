{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-all",
      "displayName": "Windows UCRT64 Ninja (DLL + tests + SDL host)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-windows",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SEMI_BUILD_DLL": "ON",
        "SEMI_BUILD_TESTS": "ON",
        "SEMI_BUILD_SDL_PLAYER": "ON"
      }
    },
    {
      "name": "windows-ci",
      "inherits": "windows-all",
      "displayName": "Windows UCRT64 CI (headless audio)",
      "binaryDir": "${sourceDir}/build-windows-ci",
      "cacheVariables": {
        "SEMI_USE_NULL_AUDIO_OUTPUT": "ON"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows UCRT64 Release (DLL + SDL host)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-windows-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SEMI_BUILD_DLL": "ON",
        "SEMI_BUILD_TESTS": "OFF",
        "SEMI_BUILD_SDL_PLAYER": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-all", "configurePreset": "windows-all" },
    { "name": "windows-ci", "configurePreset": "windows-ci" },
    { "name": "windows-release", "configurePreset": "windows-release" }
  ]
}
